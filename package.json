{
  "name": "ae-patch-verifier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vercel dev",
    "check": "npm run check:syntax && npm run check:sources && npm run check:contracts && npm run check:native && npm test",
    "check:syntax": "find api scripts native -name '*.js' ! -name engine.js -type f -print0 | xargs -0 -n1 node --check",
    "check:sources": "bash -n scripts/fetch-onceworld-source.sh scripts/download-apkpure-xapk.sh && python3 -c \"compile(open('scripts/download-play-apks.py').read(), 'scripts/download-play-apks.py', 'exec')\"",
    "check:contracts": "node scripts/check-modern-onceworld.js && node scripts/check-ae-google-play.js",
    "check:native": "node scripts/check-native-provenance.js",
    "check:fixtures": "node scripts/check-native-fixtures.js",
    "test": "node --test",
    "build": "bash scripts/build-web-engine.sh"
  }
}
