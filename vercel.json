{
  "functions": {
    "api/allrelic/build.js": { "maxDuration": 60 },
    "api/allrelic/status.js": { "maxDuration": 60 },
    "api/allrelic/download.js": { "maxDuration": 60 },
    "api/allrelic/version.js": { "maxDuration": 60 },
    "api/allrelic/module/latest.js": { "maxDuration": 30 },
    "api/lspatch/build.js": {
      "maxDuration": 60
    },
    "api/lspatch/status.js": {
      "maxDuration": 60
    },
    "api/lspatch/download.js": {
      "maxDuration": 60
    },
    "api/module/latest.js": {
      "maxDuration": 30
    },
    "api/onceworld/build.js": {
      "maxDuration": 60
    },
    "api/onceworld/status.js": {
      "maxDuration": 60
    },
    "api/onceworld/download.js": {
      "maxDuration": 60
    },
    "api/onceworld/module/latest.js": {
      "maxDuration": 30
    },
    "api/onceworld/version.js": {
      "maxDuration": 30
    },
    "api/relevel/status.js": {
      "maxDuration": 60
    },
    "api/relevel/download.js": {
      "maxDuration": 60
    },
    "api/relevel/tick.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/jszip.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/native/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "bash scripts/build-web-engine.sh",
  "outputDirectory": "."
}
