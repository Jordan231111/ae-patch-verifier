{
  "functions": {
    "api/lspatch/build.js": {
      "maxDuration": 60
    },
    "api/lspatch/status.js": {
      "maxDuration": 60
    },
    "api/lspatch/download.js": {
      "maxDuration": 60
    },
    "api/module/latest.js": {
      "maxDuration": 30
    },
    "api/relevel/status.js": {
      "maxDuration": 60
    },
    "api/relevel/download.js": {
      "maxDuration": 60
    },
    "api/relevel/tick.js": {
      "maxDuration": 60
    },
    "api/workshop.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/jszip.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/native/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "bash scripts/build-web-engine.sh",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/allrelic/version",
      "destination": "/api/workshop?game=allrelic&action=version"
    },
    {
      "source": "/api/allrelic/module/latest",
      "destination": "/api/workshop?game=allrelic&action=module/latest"
    },
    {
      "source": "/api/allrelic/build",
      "destination": "/api/workshop?game=allrelic&action=build"
    },
    {
      "source": "/api/allrelic/status",
      "destination": "/api/workshop?game=allrelic&action=status"
    },
    {
      "source": "/api/allrelic/download",
      "destination": "/api/workshop?game=allrelic&action=download"
    },
    {
      "source": "/api/onceworld/version",
      "destination": "/api/workshop?game=onceworld&action=version"
    },
    {
      "source": "/api/onceworld/module/latest",
      "destination": "/api/workshop?game=onceworld&action=module/latest"
    },
    {
      "source": "/api/onceworld/build",
      "destination": "/api/workshop?game=onceworld&action=build"
    },
    {
      "source": "/api/onceworld/status",
      "destination": "/api/workshop?game=onceworld&action=status"
    },
    {
      "source": "/api/onceworld/download",
      "destination": "/api/workshop?game=onceworld&action=download"
    }
  ]
}
